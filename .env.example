# GEMINI_API_KEY: Required for server-side Gemini, Imagen, Veo (Omni Flash), TTS, and Lyria music API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Optional server-side key for ElevenLabs voice synthesis.
# When omitted, the server automatically synthesizes multi-language voiceovers via Gemini TTS.
ELEVENLABS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
